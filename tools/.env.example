# fallcha-tools, run on the host for development (see tools/README.md).
# The service reads the process environment only, so load this file first:
#   set -a && source tools/.env && set +a
# saas/dev/bootstrap-env.sh creates tools/.env from this file and fills in the
# secrets; in Docker Compose the same keys come from the root .env instead.

# Same Postgres as the api; tables live in the fallcha_tools schema.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Comma-separated Fernet keys; the first encrypts, all decrypt. Generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOOLS_ENCRYPTION_KEYS=

# Shared with the api (api/.env TOOLS_INTERNAL_SECRET); 16+ characters.
TOOLS_INTERNAL_SECRET=

# Public URL serving /oauth/<provider>/callback. Locally this is the service
# itself; register http://localhost:8010/oauth/google-calendar/callback (and
# .../google-sheets/callback) on your Google OAuth client. Empty: OAuth off.
TOOLS_PUBLIC_BASE_URL=http://localhost:8010

# UI page the OAuth callback returns to. Empty: OAuth off.
TOOLS_UI_RETURN_URL=http://localhost:3000/integrations

LOG_LEVEL=INFO
