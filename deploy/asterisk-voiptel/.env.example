# Copy to .env and fill in. .env is gitignored -- keep it that way.
# The SIP password arrives from Voiptel over a secure channel; it belongs here
# and nowhere else.

# --- Voiptel / SkyPhone trunk ------------------------------------------------
# The extension they issued, e.g. 7065.
SIP_USER=
SIP_PASS=

# The host that actually answers SIP. As of the last probe this is the
# wildcard address 84.39.233.90 -- demo7062.skyphonecentral.com resolves to
# 54.164.171.221, which refuses connections on 5071. Switch this back to the
# hostname once Voiptel fixes the A record.
REGISTRAR_HOST=84.39.233.90
REGISTRAR_PORT=5071

# The domain used in the From URI and the AOR. Stays the hostname even while
# REGISTRAR_HOST is a bare IP -- that is what their digest realm expects.
SIP_DOMAIN=demo7062.skyphonecentral.com

REGISTRATION_EXPIRY=180

# Comma-separated. Every source IP the PBX may send INVITEs from. They
# documented 84.39.232.90; the live SIP host is 84.39.233.90. Both are listed
# until they confirm which is correct.
PBX_SIGNALLING_IPS=84.39.233.90,84.39.232.90,84.39.233.91

# --- NAT ---------------------------------------------------------------------
# This machine's current public IP. ISP-assigned, so it changes: if audio or
# registration breaks after a router reboot, re-check it first.
#   curl -s https://api.ipify.org
# Leave EMPTY to strip external_*_address entirely and rely on the far end
# latching onto our RTP source address -- try that if audio is one-way.
PUBLIC_IP=

# --- Media (must match the published UDP range in docker-compose.yaml) -------
RTP_START=10000
RTP_END=10050

# --- Inbound behaviour ------------------------------------------------------
# echo   -> Asterisk answers locally, plays a prompt and echoes audio back.
#           Proves SIP signalling and two-way RTP with Dograh out of the loop.
#           Use this for the first call with a new carrier.
# stasis -> Hand the call to Dograh. Needs the backend running and the
#           extension registered on a telephony configuration.
INBOUND_MODE=echo

# --- Dograh ------------------------------------------------------------------
# Both the ARI username/Stasis app name and the websocket_client.conf section
# name. Enter this same value in Dograh as "Stasis App Name" AND as
# "websocket_client.conf Name".
STASIS_APP=dograh
ARI_PASSWORD=

# Where Asterisk dials out for external media. host.docker.internal reaches the
# Dograh API on the Mac host, so no tunnel is needed for this leg.
DOGRAH_WS_URI=ws://host.docker.internal:8000/api/v1/telephony/ws/ari
