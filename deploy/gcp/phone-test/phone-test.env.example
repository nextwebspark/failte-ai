# Local overlay for a phone test against a copy of the live data.
# Copy to ~/dev/backups/phone-test.env (chmod 600) and source it with `set -a`.
# Never commit the real file: it holds CREDENTIALS_ENCRYPTION_KEYS.

# Everything api/.env sets (Vertex, tools, Langfuse, ...), then the overrides.
. /path/to/your/checkout/api/.env   # replace the path

# The restored copy of the live database, and a Redis db no other stack uses.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lm_phone_test
REDIS_URL=redis://:redissecret@localhost:6379/5

# Recordings go to local MinIO, not the live bucket.
ENABLE_AWS_S3=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=<local minio key>
MINIO_SECRET_KEY=<local minio secret>
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# No sign-up, receipt or missed-call emails to real people.
EMAIL_PROVIDER=none

# The live definitions use platform models, so switch them on as live does.
PLATFORM_MODELS_ENABLED=true
PLATFORM_VERTEX_PROJECT_ID=dograh-eu
PLATFORM_VERTEX_LLM_LOCATION=eu
PLATFORM_VERTEX_REALTIME_LOCATION=europe-west1
BILLING_PROVIDER=none

# Written from Secret Manager, never typed or echoed (see ../local-phone-test.md):
# CREDENTIALS_ENCRYPTION_KEYS=...
