# fallcha-tools service (tools/README.md). Copy to tools.env (gitignored), or
# let deploy/gcp/configure-env.sh write it from Secret Manager.
#
# DATABASE_URL and TOOLS_INTERNAL_SECRET are NOT set here: the overlay takes
# both from the VM's .env, because the api needs the same values.

# Comma-separated Fernet keys; the first encrypts, all decrypt. Secret
# Manager: dograh-tools-encryption-keys. Generate one with
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# or: openssl rand -base64 32 | tr '+/' '-_'
TOOLS_ENCRYPTION_KEYS=

# Public origin that nginx serves /oauth/<provider>/callback on (normally
# PUBLIC_BASE_URL). Every Google OAuth client must list
#   ${TOOLS_PUBLIC_BASE_URL}/oauth/google-calendar/callback
#   ${TOOLS_PUBLIC_BASE_URL}/oauth/google-sheets/callback
# as authorized redirect URIs. Leave empty to keep OAuth off (service-account
# connections still work).
TOOLS_PUBLIC_BASE_URL=

# UI page the OAuth callback returns the browser to: ${PUBLIC_BASE_URL}/integrations
TOOLS_UI_RETURN_URL=

# Optional platform Google OAuth client (the one Google sign-in uses), offered
# to every workspace so Calendar/Sheets connect in one click. Both or neither;
# workspaces can still add their own client. Secret Manager:
# dograh-google-oauth-client-id / dograh-google-oauth-client-secret. The client
# needs the two redirect URIs above, and the Calendar and Sheets APIs enabled.
TOOLS_GOOGLE_CLIENT_ID=
TOOLS_GOOGLE_CLIENT_SECRET=
